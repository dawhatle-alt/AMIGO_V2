# AMIGO Concierge — local environment
#
# Copy to .env.local and fill in. .env.local is git-ignored and MUST NOT be
# committed. The key is read only by the server-side /api/chat route (PRD FR-15)
# and is never shipped to the browser.

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Only for identity-linked keys (the API answers "anthropic-workspace-id is
# required"): the id of the workspace the key belongs to, from the Anthropic
# Console. Leave unset for ordinary workspace keys.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
